    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "~8.3.0",
        "ext-ctype": "*",
        "ext-curl": "*",
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "ext-iconv": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-mysqli": "*",
        "ext-openssl": "*",
        "ext-zip": "*",
        "ext-zlib": "*",
        "endroid/qr-code": "^4.4",
        "setasign/fpdf": "^1.8",
        "phpmailer/phpmailer": "^6.9"
    },
    "config": {
