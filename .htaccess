# Teatro Constitución — protecciones Apache (WAMP / producción)
# Bloquea acceso HTTP a secretos, dumps y código interno.

<IfModule mod_authz_core.c>
  # Secretos y dumps
  <FilesMatch "(?i)^(\.env|\.env\..*|\.user\.ini|.*\.(key|p12|pfx)|.*\.sql|.*\.log|.*\.md|.*\.ya?ml|.*\.bat|composer\.(json|lock)|Procfile|websec-audit.*)$">
    Require all denied
  </FilesMatch>
</IfModule>

# Directorios que no deben servirse por HTTP
RedirectMatch 403 (?i)/(includes|config|sql|docs|db_trt_25|vendor|bin|\.do)/
RedirectMatch 403 (?i)/\.(git|env)(/|$)

# Scripts de mantenimiento / debug (solo CLI)
RedirectMatch 403 (?i)/(seed_test_data|debug_columns|debug_occupancy|check_status|check_databases|test_stats|fix_schema|fix_funciones|fix_boletos_index|inspect_db|sync_historico_schema)\.php$
RedirectMatch 403 (?i)/evt_interfaz/(fix_historico|setup_historico|debug_schema)\.php$
RedirectMatch 403 (?i)/vnt_interfaz/verificar_tipo_boleto\.php$
RedirectMatch 403 (?i)/sql/truncar_datos\.php$
RedirectMatch 403 (?i)/auth/(secret_login|migrar_contrasenas)\.php$

# Separación por subdominio (producción). No aplica en localhost / IP de LAN.
# Defensa en profundidad: la seguridad real es login + rol + validación backend.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Cartel de evento que no está en disco (disco efímero) → copia en la BD.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^evt_interfaz/imagenes/([A-Za-z0-9_-]+\.(?:jpe?g|png|gif))$ evt_interfaz/imagen_evento.php?r=$1 [NC,L]

  # api.* → solo /api/
  RewriteCond %{HTTP_HOST} ^api\. [NC]
  RewriteCond %{REQUEST_URI} !^/api/ [NC]
  RewriteRule ^ - [R=404,L]

  # www.* raíz → cartelera
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^(index\.php)?$ /crt_interfaz/ [R=302,L]

  # www.* → solo sitio público; lo demás (login, paneles, taquilla) va a gestion.*
  RewriteCond %{REQUEST_URI} !^/(crt_interfaz|api/online|assets|evt_interfaz/imagenes|boletos_qr)/ [NC]
  RewriteCond %{REQUEST_URI} !^/(favicon\.ico|robots\.txt|health\.php|evt_interfaz/imagen_evento\.php)$ [NC]
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://gestion.%1%{REQUEST_URI} [R=302,L]
</IfModule>

# Cabeceras de seguridad (compatibles con taquilla/admin en HTTP local)
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(self), microphone=(), geolocation=()"
  # CSP permisiva: CDNs reales del proyecto (jsdelivr, unpkg, cdnjs, Google Fonts) y
  # Mercado Pago Checkout Bricks (SDK, Secure Fields en iframes, antifraude, estáticos mlstatic).
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; object-src 'none'; img-src 'self' data: blob: https:; font-src 'self' data: https://cdn.jsdelivr.net https://fonts.gstatic.com https://cdnjs.cloudflare.com https://http2.mlstatic.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com https://cdnjs.cloudflare.com https://http2.mlstatic.com; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://unpkg.com https://cdnjs.cloudflare.com https://sdk.mercadopago.com https://*.mercadopago.com https://*.mercadolibre.com https://http2.mlstatic.com; connect-src 'self' https://api.mercadopago.com https://www.mercadopago.com https://sdk.mercadopago.com https://*.mercadopago.com https://*.mercadolibre.com https://*.mercadolivre.com https://http2.mlstatic.com; frame-src 'self' https://www.google.com https://maps.google.com https://www.mercadopago.com https://www.mercadopago.com.mx https://sdk.mercadopago.com https://*.mercadopago.com https://*.mercadopago.com.mx https://*.mercadolibre.com https://*.mlstatic.com;"
</IfModule>
