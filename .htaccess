# Teatro Constitución — protecciones Apache (WAMP / producción)
# Bloquea acceso HTTP a secretos, dumps y código interno.

<IfModule mod_authz_core.c>
  # Secretos y dumps
  <FilesMatch "(?i)^(\.env|\.env\..*|.*\.sql|.*\.log|composer\.(json|lock)|websec-audit.*)$">
    Require all denied
  </FilesMatch>

  # Docs / instrucciones con posibles credenciales de ejemplo
  <FilesMatch "(?i)^(INSTRUCCIONES_LOGIN|FLUJO_ACCESO_ADMIN)\.md$">
    Require all denied
  </FilesMatch>
</IfModule>

# Directorios que no deben servirse por HTTP
RedirectMatch 403 (?i)/(includes|config|sql|docs|db_trt_25)/
RedirectMatch 403 (?i)/\.(git|env)(/|$)

# Scripts de mantenimiento / debug (solo CLI)
RedirectMatch 403 (?i)/(seed_test_data|debug_columns|debug_occupancy|check_status|check_databases|test_stats)\.php$
RedirectMatch 403 (?i)/sql/truncar_datos\.php$
RedirectMatch 403 (?i)/auth/(secret_login|migrar_contrasenas)\.php$

# Cabeceras de seguridad (compatibles con taquilla/admin en HTTP local)
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(self), microphone=(), geolocation=()"
  # CSP permisiva: CDNs reales del proyecto (jsdelivr, unpkg, cdnjs, Google Fonts, MP).
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; object-src 'none'; img-src 'self' data: blob: https:; font-src 'self' data: https://cdn.jsdelivr.net https://fonts.gstatic.com https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com https://cdnjs.cloudflare.com; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://unpkg.com https://cdnjs.cloudflare.com https://sdk.mercadopago.com; connect-src 'self' https://api.mercadopago.com https://www.mercadopago.com https://sdk.mercadopago.com; frame-src 'self' https://www.mercadopago.com https://www.mercadopago.com.mx https://sdk.mercadopago.com;"
</IfModule>
