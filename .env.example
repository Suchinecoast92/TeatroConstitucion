# Copia este archivo a `.env` (solo desarrollo local) y ajusta valores.
# Nunca subas `.env` a Git. En DigitalOcean App Platform NO se usa `.env`:
# las variables se configuran en la app (las secretas como tipo SECRET).
# Ver docs/DEPLOY_DIGITALOCEAN.md

# ─── Aplicación ────────────────────────────────────────────────
# local | staging | production
APP_ENV=local
# URL pública del sitio de venta (back_urls y notification_url de Mercado Pago).
# Local:      http://localhost/TeatroConstitucion
# Producción: https://www.tu-dominio.mx
APP_URL=http://localhost/TeatroConstitucion
# Zona horaria de PHP; también se aplica a cada conexión MySQL (NOW()).
APP_TIMEZONE=America/Mexico_City

# 1 SOLO si la app está detrás de un proxy de confianza (App Platform / Cloudflare):
# toma HTTPS de X-Forwarded-Proto e IP real de CF-Connecting-IP / X-Forwarded-For.
TRUST_PROXY=0

# ─── Base de datos ─────────────────────────────────────────────
# Local (WAMP): localhost:3306, root sin contraseña.
# DigitalOcean Managed MySQL: host privado del cluster, puerto 25060, DB_SSL=1.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=trt_25
DB_BACKUP_NAME=trt_25_backup
# TLS hacia MySQL (obligatorio en Managed MySQL).
DB_SSL=0
# Verificación del certificado del servidor: ruta al CA o contenido PEM
# (en App Platform: DB_SSL_CA_CERT=${nombre-db.CA_CERT}).
# DB_SSL_CA=/ruta/ca-certificate.crt
# DB_SSL_CA_CERT=
# 0 desactiva el ajuste de zona horaria por conexión (no recomendado).
# DB_ALIGN_TIMEZONE=1

# ─── Mercado Pago ──────────────────────────────────────────────
# Sin token (y APP_ENV=local) → modo mock automático, sin cuenta MP.
# mock | sandbox | live   (live solo en producción con cuenta verificada)
MP_MODE=mock
# Credenciales de PRUEBA para sandbox; reales solo en el panel de App Platform.
# El Access Token vive solo en backend. La Public Key es la única que llega al navegador.
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
# Secreto de firma de Webhooks (panel MP → Webhooks). Nunca en la URL.
MP_WEBHOOK_SECRET=
# redirect fuerza Checkout Pro (flujo anterior) aunque exista Public Key.
# MP_CHECKOUT=
# Pago en efectivo (OXXO…) en el Brick: 0 por defecto (acredita en días; holds duran minutos).
# MP_BRICK_TICKET=0
# Meses sin intereses máximos en el Brick (1 = solo contado).
# MP_MAX_CUOTAS=1

# Ventana en pasarela (holds + no expirar orden con pago PENDING). Por defecto 2700 (45 min).
# PAGO_EN_CURSO_TTL_SEG=2700

# ─── Correo de confirmación (boletos al pagar) ─────────────────
# mock → no envía: guarda cada correo como .eml en MAIL_MOCK_DIR (o en el temporal del sistema).
# smtp → envía por SMTP. off → no envía. Sin definir: mock en local, off en producción.
MAIL_MODE=mock
# MAIL_MOCK_DIR=C:/wamp64/tmp/teatro_correos
# Remitente: dominio verificado en el proveedor (SPF/DKIM), p. ej. boletos@tu-dominio.mx
MAIL_FROM=boletos@example.com
MAIL_FROM_NAME=Teatro Constitución
# MAIL_REPLY_TO=contacto@example.com
# SMTP del proveedor. En DigitalOcean los puertos 25/465/587 suelen estar bloqueados: usar 2525.
# MAIL_HOST=
# MAIL_PORT=2525
# tls (STARTTLS) | ssl | none
# MAIL_ENCRYPTION=tls
# MAIL_USER=
# MAIL_PASS=

# ─── Impresión QZ Tray (taquilla) ──────────────────────────────
# Llave privada para firmar solicitudes de QZ. En producción: variable SECRET, no archivo en Git.
# QZ_PRIVATE_KEY_PATH=
# QZ_PRIVATE_KEY=
