# Copia este archivo a `.env` y ajusta valores.
# Nunca subas `.env` a Git.

APP_ENV=local

# Base de datos (WAMP local por defecto)
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=trt_25

# Backup (opcional)
DB_BACKUP_NAME=trt_25_backup

# URL pública del sitio (importante para back_urls / webhook de MP)
# En local: http://localhost/TeatroConstitucion
# Con túnel (ngrok) para webhooks reales de MP:
# APP_URL=https://xxxx.ngrok-free.app/TeatroConstitucion
APP_URL=http://localhost/TeatroConstitucion

# Zona horaria PHP (debe coincidir con MySQL / México)
APP_TIMEZONE=America/Mexico_City

# Mercado Pago
# Sin token → modo mock automático (pruebas locales sin cuenta MP)
# MP_MODE=mock
# MP_MODE=live
# MP_ACCESS_TOKEN=APP_USR-xxxx
# MP_PUBLIC_KEY=APP_USR-xxxx
# MP_WEBHOOK_SECRET=

# Ventana en pasarela (holds + no expirar orden con pago PENDING). Por defecto 2700 (45 min).
# PAGO_EN_CURSO_TTL_SEG=2700
