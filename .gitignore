# Entorno y secretos
.env
.env.local
.env.*.local

# Dependencias
**/vendor/
composer.lock
# El lock raíz fija versiones para el build de App Platform
!/composer.lock

# Llaves privadas (QZ Tray, TLS): van en variables de entorno / fuera del repo
*.key
*.p12
*.pfx

# Logs
*.log
php_errors.log
**/php_errors.log

# QR generados en runtime
boletos_qr/*
!boletos_qr/.gitkeep
vnt_interfaz/qr_codes/
vnt_interfaz/boletos_qr/

# Dumps y respaldos (no subir BD real)
*.sql.gz
*.sql.bak
c/*.sql
!c/.gitkeep
backups/
*.dump

# IDE / SO
.vscode/
.idea/
*.swp
Thumbs.db
Desktop.ini
.DS_Store

# Temporales y diagnóstico local
es --oneline
*.tmp
*.temp

# Informes SAST (no son código de la app; además se escanean a sí mismos)
websec-audit*.txt
websec-audit*.pdf
